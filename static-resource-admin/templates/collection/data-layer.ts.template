/**
 * 목록형 데이터 레이어 — 아래 `// ===== 목적지:` 구분자마다 별도 파일로 저장.
 * (전시 카테고리 category-v2 의 data/api + data/hooks 구조를 따름)
 *
 * 치환:
 *   {Domain}        = PascalCase (항목 타입 이름으로도 사용) (예: NowMainBanner)
 *   {domain}        = camelCase 디렉터리                     (예: nowMainBanner)
 *   {domain-kebab}  = queryKey                               (예: now-main-banner)
 *   {DOMAIN_SNAKE}  = SNAKE_CASE                             (예: NOW_MAIN_BANNER)
 *   {한글 도메인}    = 로그 접두어                             (예: 컬리나우 배너관리)
 *   {항목}           = UI 문구                                (예: 배너)
 *
 * 항목 필드(imageUrl/link/name/startDate/endDate)는 예시. 8번 데이터 모델 필드로 교체.
 */

// ===== 목적지: src/app/{domain}/data/types/{domain}.ts
/** {한글 도메인} 항목 */
export type {Domain} = {
  id: number;
  imageUrl: string;
  link: string;
  name: string;
  /** ISO8601 (예: 2026-07-01T00:00:00+09:00) */
  startDate: string;
  /** ISO8601 (예: 2026-07-31T23:59:59+09:00) */
  endDate: string;
};

/** JSON 파일 전체 구조 */
export type {Domain}Data = {
  id: string;
  data: {Domain}[];
};

// ===== 목적지: src/app/{domain}/data/api/get{Domain}s.ts
import axios from 'axios';

import { RES_WEB_{DOMAIN_SNAKE}_PATH } from 'app/{domain}/constants/pathConstant';
import type { {Domain}, {Domain}Data } from 'app/{domain}/data/types/{domain}';

/**
 * {한글 도메인} 목록 조회
 */
export const get{Domain}s = async (): Promise<{Domain}[]> => {
  const { data } = await axios.get<{Domain}Data>(RES_WEB_{DOMAIN_SNAKE}_PATH);
  return data.data ?? [];
};

// ===== 목적지: src/app/{domain}/data/api/post{Domain}Image.ts
import { uploadToS3 } from 'app/memberPromotion/utils/uploadUtil';
import { RES_WEB_BASE } from 'app/memberPromotion/constants/pathConstant';
import { {DOMAIN_SNAKE}_IMAGE_BASE } from 'app/{domain}/constants/pathConstant';

/**
 * {한글 도메인} 이미지 업로드
 * `/web/images/` 하위는 업로드 시 CDN 캐시가 자동 퍼지됨
 */
export const post{Domain}Image = async ({ file, itemId }: { file: File; itemId: number }) => {
  const path = `${{DOMAIN_SNAKE}_IMAGE_BASE}/${itemId}/${file.name}`;
  await uploadToS3({ file, path });

  return `${RES_WEB_BASE}/${path}`;
};

// ===== 목적지: src/app/{domain}/data/api/put{Domain}s.ts
import { uploadToS3, createJsonFile } from 'app/memberPromotion/utils/uploadUtil';
import {
  {DOMAIN_SNAKE}_FILE_NAME,
  {DOMAIN_SNAKE}_JSON_PATH,
  {DOMAIN_SNAKE}_RESOURCE_ID,
} from 'app/{domain}/constants/pathConstant';
import type { {Domain}, {Domain}Data } from 'app/{domain}/data/types/{domain}';

/**
 * {한글 도메인} 목록 저장 (배열 전체 덮어쓰기. 노출 순서 = 배열 순서)
 */
export const put{Domain}s = async (items: {Domain}[]) => {
  const jsonData: {Domain}Data = {
    id: {DOMAIN_SNAKE}_RESOURCE_ID,
    data: items,
  };

  return uploadToS3({
    file: createJsonFile(jsonData, {DOMAIN_SNAKE}_FILE_NAME),
    path: {DOMAIN_SNAKE}_JSON_PATH,
  });
};

// ===== 목적지: src/app/{domain}/data/hooks/queryKeys.ts
const {DOMAIN_SNAKE}_KEY = ['{domain-kebab}'];
const {DOMAIN_SNAKE}_LIST_KEY = [...{DOMAIN_SNAKE}_KEY, 'list'];

export { {DOMAIN_SNAKE}_KEY, {DOMAIN_SNAKE}_LIST_KEY };

// ===== 목적지: src/app/{domain}/data/hooks/useGet{Domain}s.ts
import { useEffect } from 'react';
import { useQuery } from '@tanstack/react-query';

import useSnackbarMessage from 'shared/utils/snackbar';
import { {DOMAIN_SNAKE}_LIST_KEY } from 'app/{domain}/data/hooks/queryKeys';
import { get{Domain}s } from 'app/{domain}/data/api/get{Domain}s';

const useGet{Domain}s = () => {
  const snackbar = useSnackbarMessage();

  const queryResult = useQuery({
    queryKey: {DOMAIN_SNAKE}_LIST_KEY,
    queryFn: get{Domain}s,
  });

  const { isError, error } = queryResult;

  useEffect(() => {
    if (!isError) return;

    console.error('[{한글 도메인}] 목록 조회 실패:', error);
    snackbar.error('{항목} 목록 조회에 실패했습니다. 잠시 후 다시 시도해주세요.');
  }, [isError, error]);

  return {
    ...queryResult,
    items: queryResult.data ?? [],
  };
};

export { useGet{Domain}s };

// ===== 목적지: src/app/{domain}/data/hooks/usePost{Domain}Image.ts
import { useMutation } from '@tanstack/react-query';

import useSnackbarMessage from 'shared/utils/snackbar';
import { post{Domain}Image } from 'app/{domain}/data/api/post{Domain}Image';

const usePost{Domain}Image = () => {
  const snackbar = useSnackbarMessage();

  return useMutation({
    mutationFn: ({ file, itemId }: { file: File; itemId: number }) => post{Domain}Image({ file, itemId }),
    onSuccess() {
      snackbar.success('이미지 업로드가 완료되었습니다.');
    },
    onError(err) {
      console.error('[{한글 도메인}] 이미지 업로드 실패:', err);
      snackbar.error('이미지 업로드에 실패했습니다. 잠시 후 다시 시도해주세요.');
    },
  });
};

export { usePost{Domain}Image };

// ===== 목적지: src/app/{domain}/data/hooks/usePut{Domain}s.ts
import { useMutation, useQueryClient } from '@tanstack/react-query';

import useSnackbarMessage from 'shared/utils/snackbar';
import { {DOMAIN_SNAKE}_LIST_KEY } from 'app/{domain}/data/hooks/queryKeys';
import { put{Domain}s } from 'app/{domain}/data/api/put{Domain}s';
import type { {Domain} } from 'app/{domain}/data/types/{domain}';

/**
 * 목록 저장. actionLabel = '등록' | '수정' | '순서 변경' | '삭제'
 */
const usePut{Domain}s = ({ actionLabel }: { actionLabel: string }) => {
  const snackbar = useSnackbarMessage();
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: (items: {Domain}[]) => put{Domain}s(items),
    onSuccess() {
      queryClient.invalidateQueries({ queryKey: {DOMAIN_SNAKE}_LIST_KEY });
      snackbar.success(`{항목}이 ${actionLabel}되었습니다.`);
    },
    onError(err) {
      console.error(`[{한글 도메인}] ${actionLabel} 실패:`, err);
      snackbar.error(`{항목} ${actionLabel}에 실패했습니다. 잠시 후 다시 시도해주세요.`);
    },
  });
};

export { usePut{Domain}s };
