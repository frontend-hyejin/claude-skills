/**
 * 목적지: {app-dir}/pages/{domain}/{Domain}PromotionCreatePage.tsx
 * ⚠️ {app-dir} 가 전용 디렉터리(src/app/{domain})면 pathConstant import 를 'app/{domain}/constants/pathConstant' 로 바꾸고,
 *    PATH 이름의 `_PROMOTION` 접미어는 뺀다 (menu-registration.md 2단계 참고). dateUtil/uploadUtil/ImageUploadField 는 memberPromotion 경로 유지.
 *
 * 신규 프로모션 발행 페이지. 프로모션 기간 + 콘텐츠 입력.
 *
 * 치환:
 *   {Domain}    = PascalCase   (예: WelcomeBenefit)
 *   {한글 도메인} = 페이지 제목  (예: 첫 구매 프로모션)
 *
 * 노출 기간 정책:
 *   (A) 시작+종료일 → FormDateRangePickerField (아래 예시)
 *   (B) 시작일만    → FormDatePickerField로 교체하고 endDate/setEndDate 관련 props 삭제
 */
import React from 'react';
import { Backdrop, CircularProgress } from '@material-ui/core';

import DetailTemplate from 'shared/atomic/templates/DetailTemplate';
import Form from 'shared/atomic/organisms/Form';
import FormTextField from 'shared/atomic/molecules/FormTextField';
import FormDateRangePickerField from 'shared/atomic/molecules/FormDateRangePickerField/FormDateRangePickerField';
import Button from 'shared/atomic/atoms/Button';
import { useModal } from 'shared/providers/ModalProvider';

import { use{Domain}Form } from '../../hooks/use{Domain}Form';
import ImageUploadField, {
  IMAGE_UPLOAD_GUIDE_REQUIRE_START_DATE,
} from '../../components/ImageUploadField';
import PromotionLoadModal, { PromotionVersionItem } from '../../components/PromotionLoadModal';
import { getVersionStatus } from '../../utils/versionUtil';

function {Domain}PromotionCreatePage() {
  const form = use{Domain}Form();
  const openModal = useModal();

  const handleLoadEvent = async () => {
    if (!form.existingMeta) return;

    const { versions, defaultVersion } = form.existingMeta;
    const versionList: PromotionVersionItem[] = Object.keys(versions)
      .filter((v) => v !== defaultVersion)
      .sort()
      .reverse()
      .map((version) => ({
        version,
        status: getVersionStatus(version, form.existingMeta!),
        startDate: versions[version].startDate,
        endDate: versions[version].endDate,
      }));

    const result = await openModal(<PromotionLoadModal versions={versionList} />, {
      fullWidth: true,
      maxWidth: 'md',
      enableBackdropClick: true,
    });

    if (result?.version) {
      form.loadVersionData(result.version);
    }
  };

  return (
    <DetailTemplate menuTitle="{한글 도메인}" pageTitle="신규 프로모션 발행">
      <Form
        onSubmit={(e) => {
          e.preventDefault();
          form.handlePublish();
        }}
      >
        <div style={{ display: 'flex', justifyContent: 'flex-end', marginBottom: 8 }}>
          <Button
            variant="outlined"
            color="primary"
            size="small"
            onClick={handleLoadEvent}
            disabled={!form.existingMeta}
          >
            프로모션 불러오기
          </Button>
        </div>

        <Form.Section title="프로모션 기간">
          <div style={{ maxWidth: 500 }}>
            <FormDateRangePickerField
              id="promotionPeriod"
              label="기간"
              required
              labelWidth={120}
              startDate={form.startDate}
              endDate={form.endDate}
              setStartDate={form.setStartDate}
              setEndDate={form.setEndDate}
              unit="minutes"
              filterButtons={[]}
            />
          </div>
        </Form.Section>

        {/* TODO: 도메인 필드로 Form.Section 구성 */}

        <Form.Section title="예시 이미지 섹션">
          <ImageUploadField
            id="image"
            label="이미지"
            fileInputRef={form.fileInputRef}
            selectedFile={form.selectedFile}
            isUploading={form.isUploading}
            uploadedImageUrl={form.uploadedImageUrl}
            uploadDisabled={!form.newVersion}
            helperText={
              !form.newVersion
                ? IMAGE_UPLOAD_GUIDE_REQUIRE_START_DATE
                : '이미지 사이즈: {WIDTH} x {HEIGHT}px / 파일 형식: png, jpg, jpeg'
            }
            onFileSelect={form.handleFileSelect}
            onFileChange={form.handleFileChange}
            onUpload={form.handleUpload}
          />
          <FormTextField
            id="fieldName"
            label="한글 라벨"
            required
            labelWidth={120}
            value={/* form.someField */ ''}
            onChange={(e) => {
              /* form.setSomeField(e.target.value) */
              e.preventDefault();
            }}
            placeholder="예시"
          />
        </Form.Section>

        <Form.Actions
          submitLabel={form.isPublishing ? '발행 중...' : '발행'}
          cancelLabel="목록"
          onCancel={form.handleGoBack}
          disabled={!form.isFormValid || form.isPublishing}
        />
      </Form>
      <Backdrop open={form.isLoadingVersion} style={{ zIndex: 1300 }}>
        <CircularProgress color="inherit" />
      </Backdrop>
    </DetailTemplate>
  );
}

export default {Domain}PromotionCreatePage;
